{
  "name": "nexia-autonomy",
  "version": "0.1.3-cleopatra-takeover",
  "private": true,
  "description": "Quarantined autonomy-framework donor for possible future review inside NEXIA. Free will, consciousness, personhood, production readiness, and canonical integration are not proven.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "demo": "ts-node src/demo.ts",
    "dev": "ts-node-dev --respawn src/demo.ts",
    "test": "ts-node src/tests/hardening.test.ts && ts-node src/tests/replay-ledger-correction.test.ts && ts-node src/tests/consent-replay-capacity.test.ts",
    "test:replay": "ts-node src/tests/replay-ledger-correction.test.ts",
    "test:consent": "ts-node src/tests/consent-replay-capacity.test.ts"
  },
  "keywords": [
    "autonomy",
    "deliberation-adapter",
    "needs-simulation",
    "nexia-donor",
    "quarantined-prototype"
  ],
  "author": "Anthony D. Smith <ampdsmith>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
